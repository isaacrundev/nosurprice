# 複製成 .env.local 再填實際值(本檔 commit 沒關係,.env.local 已 gitignored)
# ponytail: 上 production 前這個 key + URL 一定要搬去後端 proxy,
# client bundle 內任何 EXPO_PUBLIC_* 變數都能從 APK 反組譯拿到。

# ⚠️ PADDLEOCR_URL 是 Cloudflare trycloudflare.com 免費 tunnel。
# 每次重啟 tunnel subdomain 會換(WSL / 網路掛掉時整支會死)。
# tunnel 重啟後必須同步更新這條 + 對應的 .env.local。
# 若要走 stable URL → 註冊 domain + 設 Cloudflare named Tunnel(免費,5 分鐘)。
EXPO_PUBLIC_PADDLEOCR_URL=https://your-tunnel.trycloudflare.com

# 跟部署者拿 API key(tunnel 的 server-side 設定檔裡也有,部署後只顯示一次)
EXPO_PUBLIC_PADDLEOCR_API_KEY=your-paddleocr-api-key-here

# 語言 model。server 端目前只載 chinese_cht;改別的會 422。
# 可選: chinese_cht(繁中) / th(泰文) / japan / en / ch(default)
EXPO_PUBLIC_PADDLEOCR_LANG=chinese_cht
